{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "requiem-warcraftlogs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Persistent cache for Warcraft Logs responses. No id: Cloudflare creates the namespace on the first deploy.
  "kv_namespaces": [
    {
      "binding": "WCL_CACHE"
    }
  ],
  "observability": {
    "enabled": true
  }
}
